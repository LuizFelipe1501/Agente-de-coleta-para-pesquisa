# Endereços
BASE_URL=https://seu-bot.vercel.app
SURVEY_URL=https://pt.surveymonkey.com/r/L3TQHL5
META_RESPOSTAS=250

# Supabase (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Acesso
ADMIN_PASSWORD=
TEAM_PASSWORD=
SESSION_SECRET=uma-frase-longa-aleatoria
CRON_SECRET=outra-frase-longa-aleatoria
WEBHOOK_SECRET=mais-uma-frase-aleatoria

# IA – Gemini (aistudio.google.com > Get API key; plano gratuito)
GEMINI_API_KEY=
MODELO_IA=gemini-3.6-flash
MODELO_SUGESTOES=gemini-3.6-flash

# E-mail (Gmail: ative verificação em 2 etapas e crie uma senha de app)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=pesquisa@seudominio.com
SMTP_PASS=
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
NOME_REMETENTE=Capital Consultoria Júnior – FGV
EMAIL_LIMITE_DIA=200
EMAIL_POR_EXECUCAO=15

# WhatsApp
# assistido = o time envia pela fila em /time/whatsapp (grátis, sem servidor extra)
# evolution = envio automático pela Evolution API (precisa de servidor ligado o tempo todo)
WPP_MODO=assistido
WPP_LOTE_POR_PESSOA=15
# Só para WPP_MODO=evolution (o instalar.sh da Oracle mostra os dois valores):
EVOLUTION_URL=https://IP-DA-ORACLE.sslip.io
EVOLUTION_API_KEY=
WPP_POR_EXECUCAO=2
WPP_INTERVALO_SEG=20
# Os números (um por pessoa) e o limite diário de cada um são cadastrados no painel /admin.

# Janela de envio (horário de Brasília; dias 0=domingo ... 6=sábado)
DIAS_ENVIO=1,2,3,4,5
HORA_INICIO=9
HORA_FIM=17
DIAS_LEMBRETE=6
DIAS_LIMPEZA=14

# Respostas do FAQ que dependem da mestranda (vazio = o agente passa para humano)
FAQ_ORIGEM_CONTATO=Seu e-mail institucional está publicado no site do seu órgão. Não guardamos seus dados depois deste contato.
FAQ_QUEM_PODE=

# Busca de contatos: domínios aceitos
DOMINIOS_PERMITIDOS=gov.br,jus.br,leg.br,mp.br,def.br,mil.br,tc.br
